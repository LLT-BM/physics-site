---
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import Disclosure from '../../components/Disclosure.astro';
import ModelShell from '../../components/ModelShell.astro';
import '../../styles/model.css';
import { published, neighbours } from '../../lib/models';
import { render } from 'astro:content';

export async function getStaticPaths(){
  const list = await published();
  return list.map(m => ({ params: { slug: m.id }, props: { m } }));
}
const { m } = Astro.props;
const { Content } = await render(m);
const { prev, next } = await neighbours(m.id);
const d = m.data;
const lead = d.lead ?? d.description;

const jsonLd = {
  '@context':'https://schema.org', '@type':'LearningResource',
  name:d.title, description:d.description,
  url:new URL(Astro.url.pathname, Astro.site).href,
  inLanguage:'ru', learningResourceType:'interactive simulation',
  educationalLevel:d.grade ?? d.level, teaches:d.section,
  datePublished:d.date.toISOString(), isAccessibleForFree:true, interactivityType:'active',
  publisher:{ '@type':'Organization', name:'LibLabTab', url:'https://liblabtab.ru' }
};
---
<Base title={`${d.title} — LibLabTab`} description={d.description}
      image={d.cover} imageAlt={`${d.title}: интерактивная модель`} jsonLd={jsonLd}>
  <article class="model">
    <h1 class="mtitle">{d.title}</h1>
    <p class="mlead">{lead}</p>

    <ModelShell src={`/sim/${d.model}`} title={d.title} slug={m.id} />

    <div class="blocks">
      <Disclosure id="theory" title="Что происходит" tone="aqua" hint="коротко о физике">
        <div class="prose"><Content /></div>
      </Disclosure>

      {d.limits.length > 0 && (
        <Disclosure id="limits" title="Границы модели" tone="rose" count={d.limits.length}>
          <ul class="limits">{d.limits.map(x => <li>{x}</li>)}</ul>
        </Disclosure>
      )}

      {d.checkpoints.length > 0 && (
        <Disclosure id="checks" title="Контрольные точки" tone="sand" count={d.checkpoints.length}
                    hint="введите настройки и сверьте показания">
          <div class="llt-tableframe">
            <div class="llt-tablewrap" tabindex="0" role="region" aria-label="Контрольные точки">
              <table>
                <thead><tr><th>Что проверяем</th><th>Настройки</th><th>Ожидаемое значение</th></tr></thead>
                <tbody>
                  {d.checkpoints.map(c => (
                    <tr><td>{c.name}</td><td class="mono">{c.setup}</td><td class="mono exp">{c.expected}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </Disclosure>
      )}

      <Disclosure id="comments" title="Комментарии" tone="lilac">
        <Comments term={d.title} />
      </Disclosure>
    </div>

    <nav class="neigh" aria-label="Соседние модели">
      {prev ? <a class="nb" href={`/models/${prev.id}/`}><i>← предыдущая</i><b>{prev.data.title}</b></a> : <span />}
      {next ? <a class="nb right" href={`/models/${next.id}/`}><i>следующая →</i><b>{next.data.title}</b></a> : <span />}
    </nav>
  </article>
</Base>

<style>
  .mtitle{font:800 clamp(1.35rem,3.6vw,2rem)/1.14 var(--disp);margin:0 0 8px;letter-spacing:-.01em}
</style>