---
import Base from '../layouts/Base.astro';
import { auth } from '../lib/auth';
const enabled = auth.enabled();
---
<Base title="Вход — LibLabTab" description="Вход по ссылке на почту. Нужен для комментариев и сохранения настроек между устройствами.">
  <section class="acc">
    <h1>Вход</h1>
    {enabled ? (
      <>
        <p class="lead">Введите почту — пришлём одноразовую ссылку. Пароль не нужен.</p>
        <form id="loginForm" class="row">
          <label for="email" class="sr">Почта</label>
          <input id="email" name="email" type="email" required autocomplete="email"
                 inputmode="email" enterkeyhint="send" placeholder="you@example.com" />
          <button type="submit" class="pri">Прислать ссылку</button>
        </form>
        <p id="msg" class="msg" role="status" aria-live="polite"></p>
        <div id="who" class="who hide"></div>
        <button id="out" type="button" class="ghost hide">Выйти</button>
      </>
    ) : (
      <>
        <p class="lead">Регистрация ещё не включена. Обсуждение моделей уже доступно через GitHub — кнопка «Комментарии» внизу каждой страницы.</p>
        <p><a class="pri link" href="https://github.com/LLT-BM/physics-site/discussions">Открыть обсуждения</a></p>
      </>
    )}
  </section>
</Base>

<style>
  .acc{max-width:560px;margin:0 auto;padding:8px 0 32px}
  h1{font:800 1.6rem var(--disp);margin:0 0 10px}
  .lead{color:var(--muted);margin:0 0 16px}
  .row{display:flex;gap:8px;flex-wrap:wrap}
  input{flex:1;min-width:220px;font:inherit;font-size:16px;padding:12px 13px;border-radius:10px;
    border:1px solid var(--line2);background:var(--surface);color:var(--ink)}
  .pri{font:inherit;font-size:16px;font-weight:600;padding:12px 16px;border-radius:10px;
    border:1px solid var(--aqua);background:var(--aqua);color:var(--on);cursor:pointer;
    min-height:48px;touch-action:manipulation}
  .ghost{margin-top:10px;font:inherit;font-size:16px;min-height:44px;padding:10px 14px;border-radius:10px;
    border:1px solid var(--line2);background:transparent;color:var(--muted);cursor:pointer}
  .link{display:inline-block;text-decoration:none}
  .msg{margin-top:12px;font-family:var(--mono);font-size:.86rem;color:var(--aqua)}
  .who{margin-top:16px;padding:12px;border:1px solid var(--line);border-radius:10px;
    background:var(--surface);font-family:var(--mono);font-size:.86rem}
  .hide{display:none}
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
</style>

<script>
  import { auth } from '../lib/auth';
  const form = document.getElementById('loginForm') as HTMLFormElement | null;
  if (form) {
    const msg = document.getElementById('msg')!;
    const who = document.getElementById('who')!;
    const out = document.getElementById('out') as HTMLButtonElement;
    const email = document.getElementById('email') as HTMLInputElement;
    auth.currentUser().then(u => {
      if (u) { who.classList.remove('hide'); who.textContent = 'Вы вошли: ' + (u.email || u.id);
               out.classList.remove('hide'); }
    });
    form.addEventListener('submit', async e => {
      e.preventDefault();
      msg.textContent = 'Отправляем…';
      const r = await auth.signInWithEmail(email.value.trim());
      msg.textContent = r.message;
    });
    out.addEventListener('click', async () => {
      await auth.signOut();
      who.classList.add('hide'); out.classList.add('hide');
      msg.textContent = 'Вы вышли.';
    });
  }
</script>