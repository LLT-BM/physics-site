---
import Base from '../layouts/Base.astro';
import { published, sections } from '../lib/models';
import fs from 'node:fs';
import path from 'node:path';

const all = await published();
const secs = await sections();
const total = all.length;

const LABEL: Record<string, string> = {
  'механика': 'Механика',
  'электричество': 'Электричество',
  'оптика': 'Оптика',
  'молекулярная-физика': 'Молекулярная физика',
  'квантовая-физика': 'Квантовая физика',
  'нелинейная-динамика': 'Нелинейная динамика',
  'гидродинамика': 'Гидродинамика',
  'астрономия': 'Астрономия'
};
const label = (s: string) => LABEL[s] ?? s;

const inlineCover = (file?: string) => {
  if (!file) return null;
  try { return fs.readFileSync(path.join(process.cwd(), 'public', file), 'utf-8'); }
  catch { return null; }
};
---
<Base title="LibLabTab — интерактивные модели физики">
  <section class="hero">
    <h1>Физика, которую можно потрогать</h1>
    <p>Интерактивные симуляции прямо в браузере: тяните магнит, крутите маятник, собирайте цепь, меняйте параметры — и смотрите, как работают законы природы.</p>
    <p class="count">моделей: <b>{total}</b> · тем: <b>{secs.length}</b></p>
  </section>

  <nav class="topics" aria-label="Темы каталога">
    <button class="topic on" data-sec="">Все темы <i>{total}</i></button>
    {secs.map(([s, list]) => (
      <button class="topic" data-sec={s}>{label(s)} <i>{list.length}</i></button>
    ))}
    <label class="sr" for="q">Поиск по каталогу</label>
    <input id="q" type="search" placeholder="поиск: маятник, диод, Бернулли…" autocomplete="off" />
    <span id="found" class="found" aria-live="polite"></span>
  </nav>

  {secs.map(([s, list]) => (
    <section class="group" data-group={s} id={s}>
      <header class="ghead">
        <h2>{label(s)}</h2>
        <a class="gmore" href={`/sections/${s}/`}>о теме →</a>
      </header>
      <div class="cards">
        {list.map(m => {
          const svg = inlineCover(m.data.cover);
          return (
            <a class="card" href={`/models/${m.id}/`}
               data-sec={m.data.section}
               data-text={(m.data.title + ' ' + m.data.description + ' ' + m.data.section).toLowerCase()}>
              {svg ? <div class="cover" aria-hidden="true" set:html={svg} />
                   : <div class="nocover" aria-hidden="true"><span>{m.data.title.charAt(0)}</span></div>}
              <div class="card-body">
                <div class="meta">
                  <span class="sec">{label(m.data.section)}</span>
                  {m.data.grade && <span class="grade">{m.data.grade} класс</span>}
                </div>
                <h3>{m.data.title}</h3>
                <p>{m.data.description}</p>
                <span class="open">открыть модель →</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  ))}
  <p id="empty" class="empty hide">Ничего не найдено. Сбросьте тему или измените запрос.</p>
</Base>

<style>
  .hero{padding:6px 0 4px}
  h1{font:800 clamp(1.5rem,5vw,2.1rem)/1.12 var(--disp);margin:0 0 10px}
  .hero p{color:var(--muted);max-width:74ch;margin:0 0 6px}
  .count{font-family:var(--mono);font-size:.86rem}
  .count b{color:var(--aqua)}
  .topics{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:16px 0 6px;
    position:sticky;top:0;z-index:20;padding:10px 0;background:var(--bg)}
  .topic{font:600 .8rem var(--mono);padding:9px 13px;min-height:40px;border-radius:999px;
    border:1px solid var(--line2);background:var(--overlay);color:var(--ink);cursor:pointer}
  .topic i{font-style:normal;color:var(--muted);margin-left:4px}
  .topic.on{background:var(--aqua);color:var(--on);border-color:var(--aqua)}
  .topic.on i{color:var(--on)}
  #q{flex:1;min-width:210px;font:inherit;font-size:16px;padding:11px 13px;border-radius:10px;
    border:1px solid var(--line2);background:var(--surface);color:var(--ink)}
  .found{font:600 .78rem var(--mono);color:var(--aqua)}
  .group{margin-top:22px}
  .group.hide{display:none}
  .ghead{display:flex;align-items:baseline;gap:12px;margin-bottom:10px;
    padding-left:11px;border-left:4px solid var(--aqua)}
  .ghead h2{font:700 1.15rem var(--disp);margin:0}
  .gmore{margin-left:auto;font:600 .78rem var(--mono);color:var(--aqua);text-decoration:none}
  .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(292px,1fr));gap:14px}
  .card{display:block;text-decoration:none;color:var(--ink);background:var(--surface);
    border:1px solid var(--line);border-radius:15px;overflow:hidden;box-shadow:var(--shadow);transition:.16s}
  .card:hover{border-color:var(--aqua);transform:translateY(-2px)}
  .card.hide{display:none}
  .cover,.nocover{aspect-ratio:1200/750;background:var(--canvas);display:block}
  .cover :global(svg){width:100%;height:100%;display:block}
  .nocover{display:grid;place-items:center;font:800 3rem var(--disp);color:var(--line2)}
  .card-body{padding:12px 13px 14px}
  .meta{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:7px}
  .sec,.grade{font:600 .7rem var(--mono);padding:4px 9px;border-radius:999px;border:1px solid var(--line2)}
  .sec{color:var(--aqua)} .grade{color:var(--muted)}
  h3{font:600 1.05rem var(--disp);margin:0 0 6px;line-height:1.25}
  .card-body p{margin:0;color:var(--muted);font-size:.9rem}
  .open{display:inline-block;margin-top:10px;font:600 .8rem var(--mono);color:var(--aqua)}
  .empty{margin-top:18px;color:var(--muted);font-family:var(--mono);font-size:.86rem}
  .hide{display:none}
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  @media (max-width:640px){ .cards{grid-template-columns:1fr} .topics{position:static} }
</style>

<script is:inline>
(function(){
  var sec = '';
  var groups = [].slice.call(document.querySelectorAll('.group'));
  var cards = [].slice.call(document.querySelectorAll('.card'));
  var q = document.getElementById('q'), found = document.getElementById('found'), empty = document.getElementById('empty');
  function apply(){
    var s = (q.value || '').trim().toLowerCase(), n = 0;
    cards.forEach(function(c){
      var ok = (!sec || c.dataset.sec === sec) && (!s || c.dataset.text.indexOf(s) >= 0);
      c.classList.toggle('hide', !ok);
      if(ok) n++;
    });
    groups.forEach(function(g){
      var visible = g.querySelectorAll('.card:not(.hide)').length;
      g.classList.toggle('hide', visible === 0);
    });
    found.textContent = 'найдено: ' + n;
    empty.classList.toggle('hide', n > 0);
  }
  document.querySelectorAll('.topic').forEach(function(b){
    b.addEventListener('click', function(){
      sec = b.dataset.sec;
      document.querySelectorAll('.topic').forEach(function(x){ x.classList.toggle('on', x === b); });
      apply();
    });
  });
  q.addEventListener('input', apply);
  apply();
})();
</script>