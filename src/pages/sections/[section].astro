---
import Base from '../../layouts/Base.astro';
import { sections } from '../../lib/models';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths(){
  const secs = await sections();
  return secs.map(([s, list]) => ({ params: { section: s }, props: { list } }));
}
const { list } = Astro.props;
const section = Astro.params.section as string;

const LABEL: Record<string, string> = {
  'механика': 'Механика', 'электричество': 'Электричество', 'оптика': 'Оптика',
  'молекулярная-физика': 'Молекулярная физика', 'квантовая-физика': 'Квантовая физика',
  'нелинейная-динамика': 'Нелинейная динамика', 'гидродинамика': 'Гидродинамика',
  'астрономия': 'Астрономия'
};
const ABOUT: Record<string, string> = {
  'механика': 'Равновесие, моменты сил и колебания: рычаг, математический и пружинный маятники.',
  'электричество': 'Постоянный и переменный ток, индукция, сборка цепей из реальных элементов.',
  'оптика': 'Геометрическая оптика: построение изображений и зеркальные полости.',
  'молекулярная-физика': 'Межмолекулярные потенциалы, связи и тепловое движение.',
  'квантовая-физика': 'Электронные облака, ядро и структура нуклона.',
  'нелинейная-динамика': 'Хаос, удвоение, клеточные автоматы и чувствительность к начальным условиям.',
  'гидродинамика': 'Неразрывность, напоры, потери и истечение жидкостей.',
  'астрономия': 'Масштабы от планковской длины до наблюдаемой Вселенной.'
};
const label = LABEL[section] ?? section;
const about = ABOUT[section] ?? 'Модели темы «' + label + '».';

const inlineCover = (file?: string) => {
  if (!file) return null;
  try { return fs.readFileSync(path.join(process.cwd(), 'public', file), 'utf-8'); }
  catch { return null; }
};
---
<Base title={`${label} — модели физики · LibLabTab`} description={about}>
  <nav class="crumbs" aria-label="Навигация">
    <a href="/">каталог</a><span>›</span><b>{label}</b>
  </nav>
  <header class="head">
    <h1>{label}</h1>
    <p>{about}</p>
    <p class="count">моделей в теме: <b>{list.length}</b></p>
  </header>
  <div class="cards">
    {list.map(m => {
      const svg = inlineCover(m.data.cover);
      return (
        <a class="card" href={`/models/${m.id}/`}>
          {svg ? <div class="cover" aria-hidden="true" set:html={svg} />
               : <div class="nocover" aria-hidden="true"><span>{m.data.title.charAt(0)}</span></div>}
          <div class="card-body">
            <div class="meta">
              {m.data.grade && <span class="grade">{m.data.grade} класс</span>}
              <span class="lvl">{m.data.level}</span>
            </div>
            <h2>{m.data.title}</h2>
            <p>{m.data.description}</p>
            <span class="open">открыть модель →</span>
          </div>
        </a>
      );
    })}
  </div>
  <p class="back"><a href="/">← все темы</a></p>
</Base>

<style>
  .crumbs{display:flex;gap:7px;align-items:center;font:600 .76rem var(--mono);color:var(--muted);margin-bottom:10px}
  .crumbs a{color:var(--aqua);text-decoration:none}
  .head{padding-left:11px;border-left:4px solid var(--aqua);margin-bottom:16px}
  h1{font:800 clamp(1.4rem,4.6vw,1.9rem)/1.15 var(--disp);margin:0 0 8px}
  .head p{color:var(--muted);max-width:72ch;margin:0 0 6px}
  .count{font-family:var(--mono);font-size:.85rem}
  .count b{color:var(--aqua)}
  .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(292px,1fr));gap:14px}
  .card{display:block;text-decoration:none;color:var(--ink);background:var(--surface);
    border:1px solid var(--line);border-radius:15px;overflow:hidden;box-shadow:var(--shadow);transition:.16s}
  .card:hover{border-color:var(--aqua);transform:translateY(-2px)}
  .cover,.nocover{aspect-ratio:1200/750;background:var(--canvas);display:block}
  .cover :global(svg){width:100%;height:100%;display:block}
  .nocover{display:grid;place-items:center;font:800 3rem var(--disp);color:var(--line2)}
  .card-body{padding:12px 13px 14px}
  .meta{display:flex;gap:6px;margin-bottom:7px;flex-wrap:wrap}
  .grade,.lvl{font:600 .7rem var(--mono);padding:4px 9px;border-radius:999px;border:1px solid var(--line2);color:var(--muted)}
  .lvl{color:var(--sand)}
  h2{font:600 1.05rem var(--disp);margin:0 0 6px;line-height:1.25}
  .card-body p{margin:0;color:var(--muted);font-size:.9rem}
  .open{display:inline-block;margin-top:10px;font:600 .8rem var(--mono);color:var(--aqua)}
  .back{margin-top:20px;font:600 .82rem var(--mono)}
  .back a{color:var(--aqua);text-decoration:none}
  @media (max-width:640px){ .cards{grid-template-columns:1fr} }
</style>