---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Интерактивные физические модели в браузере: механика, электродинамика, оптика. Запускаются без установки.',
  image = '/covers/pendulum.svg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

// На сайте обложки — лёгкие SVG. Но Telegram/VK/Facebook не показывают SVG в превью,
// поэтому для Open Graph подставляем одноимённый PNG (например /covers/ohm.svg -> /covers/ohm.png).
const ogImageUrl = image.replace('.svg', '.png');
const ogImage = new URL(ogImageUrl, Astro.site);
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph: превью ссылки в соцсетях -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="LibLabTab — интерактивная физика" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- RSS-лента -->
  <link rel="alternate" type="application/rss+xml" title="LibLabTab RSS" href="/rss.xml" />

  <!-- Локальные шрифты: отдаются с нашего домена, без блокирующих запросов к Google -->
  <link rel="stylesheet" href="/fonts/fonts.css" />
</head>
<body>
  <header class="site-head">
    <a class="logo" href="/">LibLabTab</a>
    <span class="motto">одна модель в день</span>
  </header>

  <main><slot /></main>

  <footer class="site-foot">
    © {new Date().getFullYear()} · LibLabTab · сделано на Astro · модели работают прямо в браузере
  </footer>
</body>
</html>