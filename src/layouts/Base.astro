---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Интерактивные физические модели в браузере: механика, электродинамика, оптика, квантовая физика. Запускаются без установки.',
  image = '/covers/atom.svg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

// На сайте обложки — лёгкие SVG. Telegram/VK/Facebook SVG не показывают,
// поэтому для Open Graph подставляем одноимённый PNG.
const ogImageUrl = image.replace('.svg', '.png');
const ogImage = new URL(ogImageUrl, Astro.site);
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#070c15" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Иконки: монограмма LLT -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:site_name" content="LibLabTab — интерактивная физика" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="LibLabTab — интерактивные модели физики" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />

  <link rel="alternate" type="application/rss+xml" title="LibLabTab RSS" href="/rss.xml" />
  <link rel="stylesheet" href="/fonts/fonts.css" />
</head>
<body>
  <header class="site-head">
    <a class="logo" href="/">LibLabTab</a>
    <span class="motto">одна модель в день</span>
  </header>

  <main><slot /></main>

  <footer class="site-foot">
    © {new Date().getFullYear()} · LibLabTab · сделано на Astro · модели работают прямо в браузере ·
    <a href="https://github.com/LLT-BM/physics-site">исходники</a>
  </footer>
</body>
</html>