<script is:inline>
(function(){
  var frames = new Map();
  function reg(){
    document.querySelectorAll('iframe').forEach(function(f){
      if(frames.has(f)) return;
      frames.set(f,1);
      if(!f.getAttribute('title')) f.setAttribute('title','Интерактивная модель');
      if(!f.getAttribute('loading')) f.setAttribute('loading','lazy');
      f.setAttribute('allow','fullscreen');
      var box=f.closest('.model-frame')||f.parentElement;
      if(box) box.dataset.lltFrame='1';
    });
  }
  function boxOf(src){
    var hit=null;
    frames.forEach(function(_,f){ if(f.contentWindow===src) hit=f; });
    return hit;
  }
  window.addEventListener('message',function(e){
    var d=e.data; if(!d||typeof d!=='object') return;
    var f=boxOf(e.source); if(!f) return;
    var box=f.closest('.model-frame')||f.parentElement;
    if(d.llt==='height' && box){
      var h=Math.max(320,Math.min(4000,Math.round(d.h)));
      box.dataset.auto='1';
      box.style.setProperty('--llt-h',h+'px');
    }
    if(d.llt==='scroll'){ window.scrollBy(0, d.dy||0); }
    if(d.llt==='full'){
      var url=f.getAttribute('src');
      if(url) window.open(url,'_blank','noopener');
    }
  });
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',reg); else reg();
  new MutationObserver(reg).observe(document.documentElement,{childList:true,subtree:true});
})();
</script>