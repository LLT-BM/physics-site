{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "tools",
    "public",
    ".repo-trash",
    "src/components/FrameBridge.astro"
  ],
  "compilerOptions": {
    "strictNullChecks": true,
    "allowJs": false,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true
  }
}
